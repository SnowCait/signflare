{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ADMIN_PUBKEY": "",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNER_HUB",
        "class_name": "SignerHub",
      },
    ],
  },
  "exports": {
    "SignerHub": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
